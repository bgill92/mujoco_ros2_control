<?xml version="1.0" encoding="UTF-8"?>
<!--
  Vacuum gripper demo robot: a planar two-link arm (1.0 m links) with a cylindrical
  vacuum pad under its tip.

  - upperarm starts at (0 0 1.2): the arm base is 1.2 m above the floor. The MJCF is
    always loaded through vacuum_scene.xml (see the ros2_control block in
    vacuum_robot.urdf), so this top-level pos is what places the arm in the scene.
  - joint1/joint2 are revolute about +Y (positive angles swing the links toward the
    floor). The MJCF <position> actuators are required: MujocoSystemInterface maps each
    ros2_control joint to an MJCF actuator (or the joint driving it) by name.
  - vacuum_pad is a body WITHOUT a joint (fixed to the forearm at (1.0 0 -0.15)). It
    survives compilation as a named body (MuJoCo >= 3.x never fuses eq-referenced bodies
    and defaults to fusestatic="false"); vacuum_scene.xml sets fusestatic="false"
    explicitly for portability.
  - Neutral pose (joint1 = joint2 = 0): pad center at (2.0 0 1.05), bottom face at z ≈ 1.02.
-->
<mujoco model="vacuum_gripper_robot">
  <compiler fusestatic="false" angle="radian"/>
  <worldbody>
    <body name="upperarm" pos="0 0 1.2">
      <inertial pos="0.5 0 0" mass="27" diaginertia="0.225 0.225 0.0225"/>
      <joint name="joint1" pos="0 0 0" axis="0 1 0" range="-3.14 3.14" actuatorfrcrange="-1000 1000"
             frictionloss="1.0" damping="2.0"/>
      <geom size="0.5 0.05 0.05" pos="0.5 0 0" type="box" rgba="1 0 0 1"/>
      <body name="forearm" pos="1 0 0" gravcomp="1.0">
        <inertial pos="0.5 0 0" mass="27" diaginertia="0.225 0.225 0.0225"/>
        <joint name="joint2" pos="0 0 0" axis="0 1 0" range="-3.14 3.14" actuatorfrcrange="-1000 1000"
               damping="2.0"/>
        <geom size="0.5 0.05 0.05" pos="0.5 0 0" type="box" rgba="0 0 1 1"/>
        <body name="vacuum_pad" pos="1.0 0 -0.15">
          <inertial pos="0 0 0" mass="0.5" diaginertia="0.001 0.001 0.001"/>
          <geom type="cylinder" size="0.04 0.03" rgba="0.8 0.8 0.8 1"/>
        </body>
        <site name="forearm" pos="0 0 0" quat="1.0 0 0 0"/>
      </body>
      <site name="upperarm" pos="0 0 0" quat="1.0 0 0 0"/>
    </body>
    <site name="world" pos="0 0 0" quat="1.0 0 0 0"/>
    <site name="base" pos="0 0 1.2" quat="1.0 0 0 0"/>
  </worldbody>
  <option integrator="implicitfast"/>
  <actuator>
    <position name="joint1" joint="joint1" kp="25000" dampratio="1.0" ctrlrange="-3.14159 3.14159"/>
    <position name="joint2" joint="joint2" kp="25000" dampratio="1.0" ctrlrange="-3.14159 3.14159"/>
  </actuator>
</mujoco>
